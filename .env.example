# ===========================================
# CONFIGURACIÓN DEL ENTORNO - CLINICAPHARMA
# ===========================================
# Copia este archivo a .env y ajusta los valores
# cp .env.example .env

# -------------------------------------------
# SEGURIDAD (CRÍTICO)
# -------------------------------------------
# Genera una clave segura con: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Mínimo 32 caracteres. NUNCA uses la misma en producción y desarrollo.
SECRET_KEY=tu_clave_secreta_muy_larga_y_segura_aqui_minimo_32_caracteres

# Tiempo de expiración del token JWT en minutos (ej: 30, 60, 1440)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# -------------------------------------------
# BASE DE DATOS
# -------------------------------------------
# Formato: sqlite+aiosqlite:///ruta/al/archivo.db
# Para producción usar: postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///./nexora.db

# -------------------------------------------
# SERVIDOR
# -------------------------------------------
# Host donde correrá la API (0.0.0.0 para acceder desde fuera)
HOST=0.0.0.0

# Puerto del servidor
PORT=8000

# Entorno: development, staging, production
ENVIRONMENT=development

# -------------------------------------------
# LOGGING
# -------------------------------------------
# Nivel de logs: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# -------------------------------------------
# CORS (Seguridad Frontend)
# -------------------------------------------
# Orígenes permitidos para solicitudes desde el navegador
# Separados por coma si son múltiples: http://localhost:3000,https://miapp.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# -------------------------------------------
# CONFIGURACIÓN DE NEGOCIO (Opcional)
# -------------------------------------------
# Nombre de la clínica/farmacia
BUSINESS_NAME=Mi Clínica y Farmacia

# RUC/RTN del negocio (para facturación)
BUSINESS_RTN=

# CAI de facturación (autorización SAR Honduras)
BUSINESS_CAI=

# -------------------------------------------
# NOTIFICACIONES (Futuro)
# -------------------------------------------
# Email SMTP (pendiente de implementar)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# SMS (pendiente de implementar)
SMS_API_KEY=
