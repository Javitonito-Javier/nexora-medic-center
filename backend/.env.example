# Clinicapharma Backend - Environment Configuration
# Copie este archivo a .env y ajuste los valores para su entorno

# Identificación de la aplicación
APP_NAME=Clinicapharma API
APP_ENV=local  # local, production, staging

# Seguridad - CRÍTICO: Genere una clave única para cada instalación
# Comando para generar: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=cambie-esto-por-una-clave-segura-de-al-menos-32-caracteres

# Base de datos PostgreSQL
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/clinicapharma

# CORS - Orígenes permitidos para el frontend
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://localhost:5000","http://localhost:5173"]

# Licenciamiento (opcional)
LICENSE_ENFORCEMENT_ENABLED=false
LICENSE_PUBLIC_KEY=
LICENSE_GRACE_DAYS=7

# Usuario administrador inicial
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=cambie-esto-antes-de-produccion

# Almacenamiento de archivos adjuntos
ATTACHMENT_STORAGE_DIR=local_data/attachments
ATTACHMENT_MAX_SIZE_BYTES=10485760  # 10MB
